[Unit]
Description=Simulation Runtime
Documentation=https://github.com/lihuigang/MuJoCo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=simulation
Group=simulation
WorkingDirectory=/opt/simulation-runtime
EnvironmentFile=/etc/simulation-runtime/env
ExecStart=/opt/simulation-runtime/.venv/bin/simulation-runtime serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/simulation-runtime
StateDirectory=simulation-runtime

[Install]
WantedBy=multi-user.target
